# Variáveis do `yarn dev` (carregadas pelo Modern.js; só valem no servidor/BFF, o browser não as vê).
# Valores padrão: serviços rodando na máquina com `make catalog` / `make stock` (raiz do erp).
# Para sobrescrever só na sua máquina, crie .env.local (ignorado pelo Git; modelo em .env.local.example).

CATALOG_SERVICE_URL=http://localhost:8080
STOCK_SERVICE_URL=http://localhost:8081/stock-service
CUSTOMER_SERVICE_URL=http://localhost:8082
CRM_SERVICE_URL=http://localhost:8083
SALES_SERVICE_URL=http://localhost:8084
PURCHASE_SERVICE_URL=http://localhost:8085
ACCOUNTING_SERVICE_URL=http://localhost:8086

# Módulos exibidos no menu (nomes de modules/*/module.json separados por vírgula). Vazio = todos.
# Em produção quem decide é o chart do Helm (ERP_MODULES_JSON), com as dependências já resolvidas.
# ERP_MODULES=contacts,products,sales

# Timeout das chamadas do BFF aos serviços, em ms
UPSTREAM_TIMEOUT_MS=10000
