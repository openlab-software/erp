# cp .env.local.example .env.local   (.env.local não vai para o Git e vence o .env.development)

# Exemplo: usar os serviços do cluster kind via port-forward
#   kubectl -n erp port-forward svc/catalog-service 18080:80
#   kubectl -n erp port-forward svc/stock-service 18081:80
# CATALOG_SERVICE_URL=http://localhost:18080
# STOCK_SERVICE_URL=http://localhost:18081/stock-service
# CUSTOMER_SERVICE_URL=http://localhost:18082
