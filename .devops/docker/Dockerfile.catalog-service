# Build from the repository root:
#   docker build -f .devops/docker/Dockerfile.catalog-service -t openlab/catalog-service .
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY catalog-service/pom.xml ./
RUN mvn -B dependency:go-offline
COPY catalog-service/src/ src/
RUN mvn -B package -DskipTests

FROM eclipse-temurin:21-jre-jammy
WORKDIR /deployments
RUN useradd --system --uid 1001 quarkus
ENV JAVA_OPTS="-XX:+UseParallelGC -XX:MaxRAMPercentage=75"
COPY --from=build --chown=1001 /workspace/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=1001 /workspace/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=1001 /workspace/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=1001 /workspace/target/quarkus-app/quarkus/ /deployments/quarkus/
USER 1001
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /deployments/quarkus-run.jar"]
